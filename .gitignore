# =========================================
# ORIGINMARK GITIGNORE
# =========================================

# =========================================
# NODE / NEXT.JS
# =========================================
node_modules/
.next/
out/
build/
dist/

# package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# =========================================
# ENV FILES  (CRITICAL — contains secrets)
# =========================================
.env
.env.*
!.env.example
!.env.*.example

# =========================================
# PYTHON / GENLAYER
# =========================================
__pycache__/
*.py[cod]
*.pyo

# Python virtual environment
venv/
.venv/
env/

# GenLayer local files
.genlayer/
.gltest/

# =========================================
# COVERAGE / TEMP
# =========================================
coverage/
tmp/
temp/
*.log

# =========================================
# SYSTEM FILES
# =========================================
.DS_Store
Thumbs.db
desktop.ini

# =========================================
# EDITOR FILES
# =========================================
.vscode/
.idea/
*.swp
*.swo
*~

# =========================================
